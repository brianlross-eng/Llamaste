# Architecture
BR2_x86_64=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_SHARED_STATIC_LIBS=y

# Init system: none (our binary IS init)
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y

# Device management: eudev (required for wlroots/cage HAS_UDEV dependency)
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.70"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_LLAMASTE_PATH)/board/llamaste/linux.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Bootloader
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat part_gpt normal efi_gop search search_label loadenv test echo configfile"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PCBIOS="boot linux ext2 fat part_gpt normal biosdisk search search_label loadenv test echo configfile"

# Filesystem
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# No BusyBox
# BR2_PACKAGE_BUSYBOX is not set

# ccache (research/26 — 85% build time reduction on rebuilds)
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"

# Our package
BR2_PACKAGE_LLAMASTE=y
BR2_PACKAGE_LLAMA_SERVER=y

# HTTPS downloads (model download from Hugging Face)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Voice I/O (Phase 3a)
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_LIB_MIXER=y
BR2_PACKAGE_ALSA_LIB_PCM_PLUGINS=y
BR2_PACKAGE_WHISPER_CPP=y
BR2_PACKAGE_FLITE=y
BR2_PACKAGE_ESPEAK_NG=y

# Neural TTS (Phase B) — sherpa-onnx with Piper VITS models
BR2_PACKAGE_ONNXRUNTIME=y
BR2_PACKAGE_SHERPA_ONNX=y

# WiFi support (wpa_supplicant + dhcpcd + firmware)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE_UNIX=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_LINUX_FIRMWARE=y
# Intel WiFi 6E/AX series: AX200/AX201/AX211 use QuZ/Qu firmware
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
# Intel WiFi 6E (AX210/AX211 "So" series, Meteor Lake/Tiger Lake)
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
# Intel WiFi 5 / 9260
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
# Intel WiFi 8265 / 8260
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
# Intel WiFi 22000 series (AX200/201 also need this)
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
# Realtek RTL8821CE/RTL8822CE/RTW88 series
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
# Realtek RTL88xx
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
# Regulatory database (signed) — required by CFG80211_REQUIRE_SIGNED_REGDB
# Without this the kernel uses world regulatory domain (no 5GHz channels)
BR2_PACKAGE_WIRELESS_REGDB=y
# NOTE: Intel BE200 (Wi-Fi 7 / Typhoon Peak) firmware has NO Buildroot config option.
# Files iwlwifi-ty-a0-gf-a0-*.ucode are in the rootfs overlay instead.

# Scripts
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LLAMASTE_PATH)/board/llamaste/post_build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_LLAMASTE_PATH)/board/llamaste/post_image.sh"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LLAMASTE_PATH)/board/llamaste/overlay"

# Image
BR2_TARGET_GENERIC_HOSTNAME="llamaste"
BR2_TARGET_GENERIC_ISSUE="Welcome to Llamaste"

# ---------------------------------------------------------------------------
# Desktop mode packages (labwc stacking WM + cog browser)
# ---------------------------------------------------------------------------
# labwc: stacking Wayland compositor (real desktop, not kiosk)
#   - openbox-compatible XML config (rc.xml, menu.xml, autostart)
#   - windows, resize/move, keyboard shortcuts, right-click menu
#   - Super+B: open browser  Super+Q: close  Alt+Tab: cycle
BR2_PACKAGE_LABWC=y
# Wayland protocol libraries
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
# Mesa 3D: swrast (VirtualBox/QEMU) + virgl (VirtIO) + iris (Intel real GPU)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# Graphics support libraries
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_PIXMAN=y
# labwc deps (pulled in via select, listed explicitly for clarity)
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_CAIRO_PNG=y
BR2_PACKAGE_PANGO=y
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_DEJAVU=y
# Browser for desktop: cog (WPE WebKit, Wayland-native)
BR2_PACKAGE_COG=y
BR2_PACKAGE_WPEWEBKIT=y
