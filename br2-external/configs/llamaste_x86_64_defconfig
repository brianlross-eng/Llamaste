# Architecture
BR2_x86_64=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_SHARED_STATIC_LIBS=y

# Init system: none (our binary IS init)
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y

# Device management: eudev (required for wlroots/cage HAS_UDEV dependency)
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.70"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_LLAMASTE_PATH)/board/llamaste/linux.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Bootloader
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat part_gpt normal efi_gop search search_label"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PCBIOS="boot linux ext2 fat part_gpt normal biosdisk search search_label"

# Filesystem
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# No BusyBox
# BR2_PACKAGE_BUSYBOX is not set

# ccache (research/26 — 85% build time reduction on rebuilds)
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"

# Our package
BR2_PACKAGE_LLAMASTE=y
BR2_PACKAGE_LLAMA_SERVER=y

# HTTPS downloads (model download from Hugging Face)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Voice I/O (Phase 3a)
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_LIB_MIXER=y
BR2_PACKAGE_ALSA_LIB_PCM_PLUGINS=y
BR2_PACKAGE_WHISPER_CPP=y

# Scripts
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LLAMASTE_PATH)/board/llamaste/post_build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_LLAMASTE_PATH)/board/llamaste/post_image.sh"

# Image
BR2_TARGET_GENERIC_HOSTNAME="llamaste"
BR2_TARGET_GENERIC_ISSUE="Welcome to Llamaste"

# ---------------------------------------------------------------------------
# Desktop mode packages (Wayland compositor + kiosk browser)
# ---------------------------------------------------------------------------
# Cage: single-window Wayland compositor (kiosk mode)
BR2_PACKAGE_CAGE=y
# Wayland protocol libraries
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
# Mesa 3D (software rendering + virgl for QEMU)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# Graphics support libraries
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_PIXMAN=y
# Kiosk browser for Cage compositor
# Cog is the purpose-built WPE WebKit kiosk browser for Cage.
# If BR2_PACKAGE_COG is not available in this Buildroot version,
# enable one of the fallbacks below instead.
BR2_PACKAGE_COG=y
BR2_PACKAGE_WPEWEBKIT=y
# Fallbacks (uncomment ONE if Cog/WPEWebKit unavailable):
# BR2_PACKAGE_MIDORI=y
# BR2_PACKAGE_CHROMIUM=y
