config BR2_PACKAGE_LABWC
	bool "labwc"
	depends on BR2_PACKAGE_HAS_LIBEGL
	depends on BR2_PACKAGE_HAS_LIBEGL_WAYLAND
	depends on BR2_PACKAGE_HAS_LIBGLES
	depends on BR2_PACKAGE_HAS_UDEV
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	depends on BR2_USE_MMU
	select BR2_PACKAGE_WLROOTS
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_CAIRO_PNG
	select BR2_PACKAGE_PANGO
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_LIBINPUT
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_XKEYBOARD_CONFIG  # runtime
	help
	  labwc is a wlroots-based stacking Wayland compositor.
	  It aims to be simple and fast, with a sane default
	  configuration. Uses an openbox-compatible XML config.

	  https://github.com/labwc/labwc

comment "labwc needs udev, EGL with Wayland, and OpenGL ES"
	depends on !BR2_PACKAGE_HAS_UDEV || \
		!BR2_PACKAGE_HAS_LIBEGL || \
		!BR2_PACKAGE_HAS_LIBEGL_WAYLAND || \
		!BR2_PACKAGE_HAS_LIBGLES
