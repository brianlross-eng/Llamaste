# =============================================================================
# Llamaste Minimal Kernel Configuration
# =============================================================================
# Target: x86_64 bare-metal PCs and QEMU/KVM virtual machines
# Goal: ~3-6 MB bzImage, ALL drivers built-in (no modules)
# Usage: Buildroot merges this fragment with kernel defaults
# =============================================================================

# ---------------------------------------------------------------------------
# Core architecture and scheduling
# ---------------------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_250=y
# No loadable modules — everything is built into the kernel image
CONFIG_MODULES=n

# ---------------------------------------------------------------------------
# Boot (EFI + ACPI + PCI)
# ---------------------------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ---------------------------------------------------------------------------
# Memory management
# ---------------------------------------------------------------------------
CONFIG_MMU=y
# Transparent hugepages for mmap-heavy LLM inference (GGML model files)
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_HUGETLBFS=y

# ---------------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------------
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
# ext4 for the writable DATA partition
CONFIG_EXT4_FS=y
# squashfs for the immutable SYS-A / SYS-B root partitions
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
# Overlay filesystem (required for live mode squashfs pivot)
CONFIG_OVERLAY_FS=y
# ISO 9660 for live ISO boot
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
# VFAT for EFI System Partition
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# NTFS read support for USB drives
CONFIG_NTFS3_FS=y

# ---------------------------------------------------------------------------
# Storage drivers (all built-in, not modules)
# ---------------------------------------------------------------------------
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
# PIIX/ICH IDE controller (needed for QEMU default IDE CD-ROM)
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
# Loop device (required for squashfs overlay in live mode)
CONFIG_BLK_DEV_LOOP=y
# Intel I225/I226 2.5GbE Ethernet (Meteor Lake, modern Intel laptops/desktops)
CONFIG_IGC=y
# USB host controllers (must be enabled for USB_STORAGE to work)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y

# SCSI subsystem (needed by USB storage, some SATA controllers, and virtio-scsi)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# SCSI CD-ROM driver (needed for ISO live boot from CD/DVD/USB)
CONFIG_BLK_DEV_SR=y
CONFIG_CDROM=y

# ---------------------------------------------------------------------------
# Hypervisor / VM guest support (required for vmwgfx DRM driver)
# ---------------------------------------------------------------------------
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# ---------------------------------------------------------------------------
# Virtio (QEMU / KVM guest support)
# ---------------------------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# Kernel-level DHCP so network works without any userspace DHCP client
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_MULTICAST=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y

# Intel NICs (covers most server and desktop Intel Ethernet)
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IXGBE=y

# Realtek NICs (covers most consumer/desktop Realtek Ethernet)
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y

# ---------------------------------------------------------------------------
# Console and serial (headless + QEMU serial)
# ---------------------------------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_PRINTK=y

# ---------------------------------------------------------------------------
# Watchdog (PID 1 supervisor uses hardware watchdog for recovery)
# ---------------------------------------------------------------------------
CONFIG_WATCHDOG=y
CONFIG_SOFT_WATCHDOG=y
CONFIG_I6300ESB_WDT=y

# ---------------------------------------------------------------------------
# Thermal monitoring (CPU temperature awareness for throttling)
# ---------------------------------------------------------------------------
CONFIG_THERMAL=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_ACPI_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y

# ---------------------------------------------------------------------------
# Power management (CPU frequency scaling + battery/AC for laptops)
# ---------------------------------------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y

# ---------------------------------------------------------------------------
# Graphics / Wayland prerequisites (desktop mode)
# ---------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
# Virtual GPU drivers (QEMU/VirtualBox/VMware)
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y
CONFIG_DRM_BOCHS=y
# Catch-all DRM for EFI framebuffers (works on any hardware)
CONFIG_DRM_SIMPLEDRM=y
# Intel integrated graphics (common on real hardware)
CONFIG_DRM_I915=y
# Input subsystem
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
# IPC and threading primitives required by Wayland/Mesa
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
# Framebuffer (fallback console)
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---------------------------------------------------------------------------
# Sound subsystem (Voice I/O: ALSA capture + playback)
# ---------------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
# Intel HDA (most real desktop/laptop hardware)
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_GENERIC=y
# Intel ICH / AC'97 (VirtualBox, older hardware)
CONFIG_SND_INTEL8X0=y
# USB microphones
CONFIG_SND_USB_AUDIO=y

# ---------------------------------------------------------------------------
# WiFi subsystem (cfg80211 + mac80211 + popular drivers, all built-in)
# ---------------------------------------------------------------------------
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
# Intel WiFi (iwlwifi covers 3160/7260/8260/9260/AX200/AX201/AX210)
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
# Realtek RTL8822CE / RTL8821CE PCIe
CONFIG_RTW88=y
CONFIG_RTW88_PCI=y
CONFIG_RTW88_8821C=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8822C=y
CONFIG_RTW88_8822CE=y
# Embed RTL8821CE firmware in kernel image (needed since MODULES=n and no initramfs;
# firmware must be available at probe time before squashfs is mounted)
CONFIG_EXTRA_FIRMWARE="rtw88/rtw8821c_fw.bin"
CONFIG_EXTRA_FIRMWARE_DIR="/mnt/d/Llamaste/br2-external/board/llamaste/overlay/lib/firmware"
# Realtek USB WiFi (RTL8192CU, older dongles)
CONFIG_RTL8192CU=y
# Atheros / Qualcomm ath10k
CONFIG_ATH_COMMON=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
# Atheros ath9k (older hardware)
CONFIG_ATH9K=y
# MediaTek MT7921 (recent budget WiFi 6 chips)
CONFIG_MT7921E=y

# ---------------------------------------------------------------------------
# Explicitly disabled subsystems
# ---------------------------------------------------------------------------
# CONFIG_BLUETOOTH is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_SERIO_SERPORT is not set
# CONFIG_LOGO is not set
# CONFIG_SECURITY is not set
# CONFIG_AUDIT is not set
# CONFIG_PROFILING is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_POSIX_MQUEUE is not set
