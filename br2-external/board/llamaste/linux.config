# =============================================================================
# Llamaste Minimal Kernel Configuration
# =============================================================================
# Target: x86_64 bare-metal PCs and QEMU/KVM virtual machines
# Goal: small bzImage, core drivers built-in, WiFi/GPU drivers as modules
# Usage: Buildroot merges this fragment with kernel defaults
# =============================================================================

# ---------------------------------------------------------------------------
# Core architecture and scheduling
# ---------------------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
# BLK_DEV_INITRD kept for bootloader-supplied initrd (not used by default)
# PXE boot uses a separate bzImage-pxe with embedded initramfs — do NOT set
# CONFIG_INITRAMFS_SOURCE here or normal boot will break (kernel runs the
# embedded /init shell script instead of init=/opt/llamaste/llamaste)
CONFIG_BLK_DEV_INITRD=y
# ---------------------------------------------------------------------------
# Real-time preemption (PREEMPT_RT) — deterministic inference latency
# Mainlined in 6.12. Trades throughput for lower worst-case latency.
# Critical for LLM inference: ensures token generation isn't delayed
# by kernel work (especially on single-CPU/low-core systems).
# ---------------------------------------------------------------------------
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_RT=y
CONFIG_HZ_250=y
# Loadable modules for WiFi/GPU drivers — loaded after squashfs pivot
# so firmware files in /lib/firmware/ are accessible at module load time
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---------------------------------------------------------------------------
# Boot (EFI + ACPI + PCI)
# ---------------------------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ---------------------------------------------------------------------------
# IOMMU (Intel VT-d / AMD-Vi) — required for DMA on modern hardware
# ---------------------------------------------------------------------------
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
# NOT PASSTHROUGH — avoids silent memory corruption on devices doing DMA
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y

# ---------------------------------------------------------------------------
# PCIe infrastructure (hotplug, power management)
# ---------------------------------------------------------------------------
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y

# ---------------------------------------------------------------------------
# Memory management
# ---------------------------------------------------------------------------
CONFIG_MMU=y
# TRANSPARENT_HUGEPAGE depends on !PREEMPT_RT in 6.12 — disabled for RT latency
# Model loading (mmap) still works, just without THP optimization
CONFIG_HUGETLBFS=y

# ---------------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------------
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
# ext4 for the writable DATA partition
CONFIG_EXT4_FS=y
# squashfs for the immutable SYS-A / SYS-B root partitions
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
# Overlay filesystem (required for live mode squashfs pivot)
CONFIG_OVERLAY_FS=y
# ISO 9660 for live ISO boot
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
# VFAT for EFI System Partition
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# NTFS read support for USB drives
CONFIG_NTFS3_FS=y

# ---------------------------------------------------------------------------
# Storage drivers (all built-in, not modules)
# ---------------------------------------------------------------------------
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
# PIIX/ICH IDE controller (needed for QEMU default IDE CD-ROM)
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
# Loop device (required for squashfs overlay in live mode)
CONFIG_BLK_DEV_LOOP=y
# RAM block device (required for PXE boot — iPXE loads squashfs as initrd into /dev/ram0)
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=262144
# Intel I225/I226 2.5GbE Ethernet (Meteor Lake, modern Intel laptops/desktops)
CONFIG_IGC=y
# USB host controllers (must be enabled for USB_STORAGE to work)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y

# SCSI subsystem (needed by USB storage, some SATA controllers, and virtio-scsi)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# SCSI CD-ROM driver (needed for ISO live boot from CD/DVD/USB)
CONFIG_BLK_DEV_SR=y
CONFIG_CDROM=y

# ---------------------------------------------------------------------------
# Hypervisor / VM guest support (required for vmwgfx DRM driver)
# ---------------------------------------------------------------------------
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# ---------------------------------------------------------------------------
# Virtio (QEMU / KVM guest support)
# ---------------------------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# Kernel-level DHCP so network works without any userspace DHCP client
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_MULTICAST=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y

# Intel NICs (covers most server and desktop Intel Ethernet)
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IXGBE=y

# Realtek NICs (covers most consumer/desktop Realtek Ethernet)
# R8169 covers RTL8125/RTL8126 2.5GbE since kernel 5.9
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y

# Broadcom NICs (HP/Dell servers + desktops, ~15-20% of market)
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_BNXT=m
CONFIG_B44=m

# Marvell / Aquantia (multi-gig NICs, some motherboards)
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_AQTION=m
CONFIG_SKGE=m
CONFIG_SKY2=m

# Qualcomm/Atheros (Killer NICs in gaming laptops)
CONFIG_NET_VENDOR_QUALCOMM=y
CONFIG_ALX=m
CONFIG_ATL1C=m

# Mellanox (workstation/server 10G/25G/40G)
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m

# JMicron (some motherboards)
CONFIG_JME=m

# ---------------------------------------------------------------------------
# Console and serial (headless + QEMU serial)
# ---------------------------------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_PRINTK=y

# ---------------------------------------------------------------------------
# Watchdog (PID 1 supervisor uses hardware watchdog for recovery)
# ---------------------------------------------------------------------------
CONFIG_WATCHDOG=y
CONFIG_SOFT_WATCHDOG=y
CONFIG_I6300ESB_WDT=y

# ---------------------------------------------------------------------------
# Thermal monitoring (CPU temperature awareness for throttling)
# ---------------------------------------------------------------------------
CONFIG_THERMAL=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_ACPI_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y

# ---------------------------------------------------------------------------
# ACPI platform support (laptops: battery, backlight, buttons, fans)
# ---------------------------------------------------------------------------
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_WMI=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_POWER_SUPPLY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# ---------------------------------------------------------------------------
# Power management (CPU frequency scaling)
# ---------------------------------------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_X86_AMD_PSTATE=y

# ---------------------------------------------------------------------------
# I2C subsystem (built-in — needed for touchpads, sensors, platform devices)
# ---------------------------------------------------------------------------
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MUX=y

# ---------------------------------------------------------------------------
# I2C platform controllers (modules — loaded by eudev after squashfs pivot)
# ---------------------------------------------------------------------------
CONFIG_I2C_I801=m
CONFIG_I2C_PIIX4=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_I2C_HID_ACPI=m

# ---------------------------------------------------------------------------
# HID subsystem (built-in — keyboards, mice, touchpads)
# ---------------------------------------------------------------------------
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB_HID=y
CONFIG_I2C_HID_CORE=m

# ---------------------------------------------------------------------------
# Pinctrl (built-in core + platform modules for Intel LPSS / AMD)
# ---------------------------------------------------------------------------
CONFIG_PINCTRL=y
# Intel LPSS MFD — parent driver for I2C/SPI on Kaby Lake+ (REQUIRED for touchpads)
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
# Intel platform pinctrl drivers
CONFIG_PINCTRL_INTEL=m
CONFIG_PINCTRL_CANNONLAKE=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_PINCTRL_SUNRISEPOINT=m
CONFIG_PINCTRL_LEWISBURG=m
CONFIG_PINCTRL_BROXTON=m
CONFIG_PINCTRL_GEMINILAKE=m
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_JASPERLAKE=m
CONFIG_PINCTRL_LAKEFIELD=m
CONFIG_PINCTRL_ELKHARTLAKE=m
CONFIG_PINCTRL_EMMITSBURG=m
# AMD pinctrl
CONFIG_PINCTRL_AMD=y

# ---------------------------------------------------------------------------
# Input drivers (PS/2 built-in for basic keyboards, I2C/SMBus for touchpads)
# ---------------------------------------------------------------------------
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_ELAN_I2C=m
CONFIG_MOUSE_ELAN_I2C_SMBUS=y

# ---------------------------------------------------------------------------
# Graphics / Wayland prerequisites (desktop mode)
# ---------------------------------------------------------------------------
CONFIG_DRM=y
# QR panic codes — scannable debug info on kernel panic (6.12+)
# Encodes panic message + registers into QR code displayed on screen
CONFIG_DRM_PANIC=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
# Virtual GPU drivers (QEMU/VirtualBox/VMware)
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y
CONFIG_DRM_BOCHS=y
# EFI framebuffer → simple-framebuffer platform device (required for simpledrm on 6.12+)
CONFIG_SYSFB_SIMPLEFB=y
# Catch-all DRM for EFI framebuffers (works on any hardware)
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_DRM_I915 is not set
# i915 depends on !PREEMPT_RT in 6.12 — use simpledrm+pixman fallback
# Intel Xe (DRM_XE) covers Meteor Lake+ GPUs and IS compatible with RT

# --- AMD GPU (module) — loaded explicitly before eudev trigger ---
# MUST be =m, NOT =y! Built-in steals display from simpledrm before
# rootfs is mounted → black screen (no firmware at kernel init time).
# Loaded via finit_module() in init_load_critical_modules() after squashfs pivot.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y
# HSA/KFD for GPU compute (Vulkan/ROCm) — required for /dev/kfd
CONFIG_HSA_AMD=y
CONFIG_DRM_AMDGPU_WERROR=n
# DRM memory managers (shared by amdgpu + nouveau)
CONFIG_DRM_TTM=y
CONFIG_DRM_BUDDY=m
CONFIG_DRM_SCHED=m

# --- NVIDIA nouveau (module) — open-source, basic display + 2D accel ---
CONFIG_DRM_NOUVEAU=m

# --- Intel Xe (kernel 6.12 — Meteor Lake, Lunar Lake, Battlemage GPUs) ---
CONFIG_DRM_XE=m
# Input subsystem
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
# IPC and threading primitives required by Wayland/Mesa
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
# Framebuffer (fallback console)
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---------------------------------------------------------------------------
# Sound subsystem (Voice I/O: ALSA capture + playback)
# ---------------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
# Intel HDA (most real desktop/laptop hardware)
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_CA0110=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_VIA=m
CONFIG_SND_HDA_GENERIC=y
# SoC audio framework (modern Intel laptops with DSP audio)
CONFIG_SND_SOC=m
# Intel ICH / AC'97 (VirtualBox, older hardware)
CONFIG_SND_INTEL8X0=y
# USB microphones
CONFIG_SND_USB_AUDIO=y

# ---------------------------------------------------------------------------
# WiFi subsystem — core stack built-in, ALL vendor drivers as modules
# Broad hardware compatibility: Intel, Realtek, Qualcomm, MediaTek, Broadcom,
# Ralink — both PCIe and USB. Modules loaded after squashfs pivot when
# /lib/firmware/ is available.
# ---------------------------------------------------------------------------
# Core wireless stack stays built-in (always available)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
# Disable signed regdb requirement — signature mismatch between
# wireless-regdb package and kernel built-in keys causes
# "cfg80211: failed to load regulatory.db" → world domain → no 5GHz.
# Requires EXPERT + CERTIFICATION_ONUS to unlock the option.
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
# Firmware loading from /lib/firmware/ (needed for module-loaded drivers)
CONFIG_FW_LOADER=y
# CRITICAL: Disable userspace firmware helper — no shell means 60s timeouts
# per missing firmware file. Direct kernel firmware loading only.
# CONFIG_FW_LOADER_USER_HELPER is not set
# USB subsystem support (needed for USB WiFi dongles)
CONFIG_USB_NET_DRIVERS=y

# --- USB Ethernet adapters (dongles) ---
# Built-in (=y) for PXE boot — modules aren't available before squashfs pivot
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_SR9700=y
CONFIG_USB_NET_SR9800=y
CONFIG_USB_NET_CH9200=y
CONFIG_USB_NET_AQC111=y
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_MII=y
# Dependencies for USB ethernet drivers
CONFIG_PHYLINK=y
CONFIG_USB_WDM=m

# --- Intel WiFi (iwlwifi: 3160/7260/8260/9260/AX200/AX201/AX210/BE200) ---
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m

# --- Realtek RTW88 PCIe (RTL8821CE, RTL8822CE, RTL8822BE) ---
CONFIG_RTW88=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_PCI=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8821C=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822B=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822C=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8822CU=m

# --- Realtek RTW89 PCIe (WiFi 6/6E: RTL8852AE, RTL8852BE, RTL8852CE) ---
CONFIG_RTW89=m
CONFIG_RTW89_CORE=m
CONFIG_RTW89_PCI=m
CONFIG_RTW89_8852A=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852B=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852C=m
CONFIG_RTW89_8852CE=m

# --- Realtek RTL8xxxU USB (RTL8188EU/CU/FU, RTL8192EU — very common cheap dongles) ---
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y

# --- Realtek legacy USB (RTL8192CU and others) ---
CONFIG_RTLWIFI=m
CONFIG_RTL8192CU=m

# --- Qualcomm/Atheros ath10k (QCA9880, QCA6174, QCA9377) ---
CONFIG_ATH_COMMON=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH10K_USB=m
# --- Qualcomm ath11k (WiFi 6: QCA6390, WCN6855, WCN6856) ---
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
# --- Qualcomm ath12k (WiFi 7 — mature in kernel 6.12) ---
CONFIG_ATH12K=m
# --- Atheros ath9k (older AR9002/AR9003 hardware) ---
CONFIG_ATH9K=m
CONFIG_ATH9K_HW=m
CONFIG_ATH9K_COMMON=m

# --- MediaTek MT76 PCIe (MT7921, MT7922 — budget WiFi 6) ---
CONFIG_MT76_CORE=m
CONFIG_MT76_CONNAC_LIB=m
CONFIG_MT7921_COMMON=m
CONFIG_MT7921E=m
# --- MediaTek MT7925 PCIe (WiFi 7, EVO-X2 GMKtec — vendor=14c3 device=0717) ---
CONFIG_MT7925_COMMON=m
CONFIG_MT7925E=m
# --- MediaTek MT76 USB (MT7612U, MT7610U, MT7921U dongles) ---
CONFIG_MT76_USB=m
CONFIG_MT76x02_LIB=m
CONFIG_MT76x02_USB=m
CONFIG_MT76x0_COMMON=m
CONFIG_MT76x0U=m
CONFIG_MT76x2_COMMON=m
CONFIG_MT76x2U=m
CONFIG_MT7921U=m

# --- Broadcom FullMAC (BCM4356, BCM4371, BCM43455 — Dell, HP, RPi) ---
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
# --- Broadcom SoftMAC (older BCM43xx PCIe, pre-FullMAC) ---
CONFIG_BRCMSMAC=m

# --- Ralink/MediaTek RT2800 USB + PCIe (RT5370, RT5572 — cheap dongles) ---
# CRC-CCITT built-in: required by rt2800lib (eliminates Unknown symbol spam)
CONFIG_CRC_CCITT=y
CONFIG_RT2X00=m
CONFIG_RT2X00_LIB=m
CONFIG_RT2X00_LIB_USB=m
CONFIG_RT2X00_LIB_PCI=m
CONFIG_RT2800_LIB=m
CONFIG_RT2800USB=m
CONFIG_RT2800PCI=m

# ---------------------------------------------------------------------------
# Bluetooth (modules — loaded by eudev for USB BT controllers)
# BlueZ userspace + dbus required for HID pairing
# ---------------------------------------------------------------------------
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
# HCI drivers (USB Bluetooth adapters + vendor firmware loaders)
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m
CONFIG_BT_INTEL=m
CONFIG_BT_RTL=m
CONFIG_BT_BCM=m

# ---------------------------------------------------------------------------
# Explicitly disabled subsystems
# ---------------------------------------------------------------------------
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_SERIO_SERPORT is not set
# CONFIG_LOGO is not set
# CONFIG_SECURITY is not set
# CONFIG_AUDIT is not set
# CONFIG_PROFILING is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_POSIX_MQUEUE is not set
