tools/sign-helper.exe

# Host/dev build directories (generated, not source)
src/llamaste/build-host/
tests/build/

# Model files (large, distributed separately)
*.gguf

# Accidental Windows reserved-name files
nul
con
prn
aux

# VirtualBox VM runtime files (large binary, machine-specific)
